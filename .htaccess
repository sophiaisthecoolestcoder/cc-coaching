# Apache config for IONOS Webhosting. Uploaded with the site by tools/deploy.sh.

# One canonical address: https://cc-coaching.net/ (matches sitemap.xml).
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://cc-coaching.net%{REQUEST_URI} [L,R=301]

AddType font/woff2 .woff2

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Enforces the zero-third-party rule on the live site.
  # script-src: the hash is the one-line `js` class script in every <head>.
  #   If that line changes, recompute:
  #   printf "%s" "<script body>" | openssl dgst -sha256 -binary | base64
  # style-src 'unsafe-inline': index.html still carries four style="" attributes.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-/x7W7R75k8Roq0WaVRQX9blP4OufE5xbAdzklGxsgpw='; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
